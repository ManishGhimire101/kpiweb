generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

model Institution {
  id           Int     @id @default(autoincrement())
  name         String
  code         String  @unique
  type         String?
  logo         String?
  email        String?
  phone        String?
  address      String?
  website      String?
  customDomain String? @unique
  subdomain    String? @unique
  themeColor   String  @default("#2563eb")
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  programs Program[]
  uploads  Upload[]

  studentProfiles StudentProfile[]
  teacherProfiles TeacherProfile[]
  parentProfiles  ParentProfile[]
  adminProfiles   AdminProfile[]

  classes    Class[]
  homework   Homework[]
  resources  Resource[]
  attendance Attendance[]
  complaints Complaint[]
}

model User {
  id                 Int       @id @default(autoincrement())
  institutionId      Int?
  username           String    @unique
  email              String?   @unique
  passwordHash       String
  role               UserRole
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  lastLoginAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  adminProfile   AdminProfile?
  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
  parentProfile  ParentProfile?
}

model AdminProfile {
  id            Int @id @default(autoincrement())
  userId        Int @unique
  institutionId Int

  name        String
  phone       String?
  designation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
}

model StudentProfile {
  id            Int @id @default(autoincrement())
  userId        Int @unique
  institutionId Int

  studentCode   String
  firstName     String
  lastName      String?
  dob           DateTime?
  gender        String?
  phone         String?
  address       String?
  admissionDate DateTime?
  status        String?
  classId       Int?
  rollNo        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution    Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  class          Class?               @relation(fields: [classId], references: [id], onDelete: SetNull)
  parentStudents ParentStudent[]
  submissions    HomeworkSubmission[]
  attendance     Attendance[]
  complaints     Complaint[]

  @@unique([institutionId, studentCode])
}

model TeacherProfile {
  id            Int @id @default(autoincrement())
  userId        Int @unique
  institutionId Int

  employeeCode String
  firstName    String
  lastName     String?
  phone        String?
  address      String?
  joiningDate  DateTime?
  designation  String?
  status       String?

  themeColor String  @default("#2563eb")
  subdomain  String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  classes     TeacherClass[]
  homework    Homework[]
  resources   Resource[]
  attendance  Attendance[]
  complaints  Complaint[]

  @@unique([institutionId, employeeCode])
}

model ParentProfile {
  id            Int @id @default(autoincrement())
  userId        Int @unique
  institutionId Int

  firstName  String
  lastName   String?
  phone      String?
  address    String?
  occupation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  students ParentStudent[]
}

model ParentStudent {
  id           Int     @id @default(autoincrement())
  parentId     Int
  studentId    Int
  relationship String?
  isPrimary    Boolean @default(false)

  parent  ParentProfile  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
}

model Program {
  id            Int @id @default(autoincrement())
  institutionId Int

  name    String
  details String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  courses     Course[]
}

model Course {
  id        Int @id @default(autoincrement())
  programId Int

  title   String
  details String?
  isFree  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
}

model Upload {
  id            Int @id @default(autoincrement())
  institutionId Int

  category String
  title    String?
  details  String?
  imageUrl String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Class {
  id            Int     @id @default(autoincrement())
  institutionId Int
  name          String
  section       String  @default("")
  academicYear  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  students    StudentProfile[]
  teachers    TeacherClass[]
  homework    Homework[]
  resources   Resource[]
  attendance  Attendance[]

  @@unique([institutionId, name, section])
}

model TeacherClass {
  id        Int    @id @default(autoincrement())
  teacherId Int
  classId   Int
  subject   String @default("")

  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class   Class          @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([teacherId, classId, subject])
}

model Homework {
  id            Int      @id @default(autoincrement())
  institutionId Int
  classId       Int
  teacherId     Int
  title         String
  description   String?
  subject       String?
  dueDate       DateTime
  files         Json     @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  class       Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher     TeacherProfile       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  submissions HomeworkSubmission[]

  @@index([classId, dueDate])
}

model HomeworkSubmission {
  id         Int       @id @default(autoincrement())
  homeworkId Int
  studentId  Int
  note       String?
  files      Json      @default("[]")
  isLate     Boolean   @default(false)
  grade      String?
  feedback   String?
  reviewedAt DateTime?

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  homework Homework       @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student  StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([homeworkId, studentId])
}

model Resource {
  id            Int     @id @default(autoincrement())
  institutionId Int
  classId       Int
  teacherId     Int
  title         String
  description   String?
  subject       String?
  files         Json    @default("[]")

  createdAt DateTime @default(now())

  institution Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  class       Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher     TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([classId])
}

model Attendance {
  id            Int              @id @default(autoincrement())
  institutionId Int
  classId       Int
  studentId     Int
  markedById    Int
  date          DateTime         @db.Date
  status        AttendanceStatus
  remark        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  class       Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  markedBy    TeacherProfile @relation(fields: [markedById], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([classId, date])
}

model Complaint {
  id            Int       @id @default(autoincrement())
  institutionId Int
  teacherId     Int
  studentId     Int
  subject       String
  message       String
  readAt        DateTime?

  createdAt DateTime @default(now())

  institution Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  teacher     TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}
